From f90953767bf542b2257d7c614e483a76260fd32a Mon Sep 17 00:00:00 2001
From: FrancescoFerraro <francesco.f@variscite.com>
Date: Sat, 1 Jun 2024 13:09:43 +0200
Subject: [PATCH] uboot_env: extend line length to 4096

This avoid cutting commands longer than 1024 chars

Upstream-Status: Pending
Signed-off-by: Pierluigi Passaro <pierluigi.p@variscite.com>
Signed-off-by: FrancescoFerraro <francesco.f@variscite.com>
---
 src/uboot_env.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

--- a/src/uboot_env.c
+++ b/src/uboot_env.c
@@ -766,7 +766,7 @@ static int libuboot_load(struct uboot_ct
 	return ctx->valid ? 0 : -ENODATA;
 }
 
-#define LINE_LENGTH 2048
+#define LINE_LENGTH 4098
 int libuboot_load_file(struct uboot_ctx *ctx, const char *filename)
 {
 	FILE *fp;
